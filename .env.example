# PostgreSQL (local Windows service or Docker)
DATABASE_URL=
POSTGRES_PASSWORD=

# AES-256-GCM key for GitHub tokens (32 bytes hex = 64 hex chars)
ENCRYPTION_KEY=

PORT=4000
GITHUB_API_BASE="https://api.github.com"
JWT_SECRET=
WEBHOOK_SECRET=
FRONTEND_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NODE_ENV="development"
TRUST_PROXY="0"
# Optional cookie SameSite attribute: "lax" (default) or "none" (required for cross-origin Railway deployments where frontend and backend are on different domains)
COOKIE_SAME_SITE="lax"
