# PostgreSQL (local Windows service or Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cicd_dashboard?schema=public"

# AES-256-GCM key for GitHub tokens (32 bytes hex = 64 hex chars)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

PORT=4000
GITHUB_API_BASE="https://api.github.com"
JWT_SECRET="change-me-to-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:3000"
